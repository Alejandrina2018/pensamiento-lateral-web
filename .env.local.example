# REQUIRED IN PRODUCTION — see README.md's "Required production
# configuration". Without these, the site has no functional contact CTA:
# the WhatsApp button / "Escribinos" link simply don't render (never a
# broken link, but never a fallback channel either).

# WhatsApp CTA (CLAUDE.md #21). Digits only, with country code, no symbols — e.g. 5491122223333.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Contact email shown in the footer / contact page (CLAUDE.md #21).
NEXT_PUBLIC_CONTACT_EMAIL=
