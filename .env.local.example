# REQUIRED IN PRODUCTION — see README.md's "Required production
# configuration". Without these, the site has no functional contact CTA:
# the WhatsApp button / "Escribinos" link simply don't render (never a
# broken link, but never a fallback channel either).

# WhatsApp CTA (CLAUDE.md #21). Digits only, with country code, no symbols — e.g. 5491122223333.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Contact email shown in the footer / contact page (CLAUDE.md #21).
NEXT_PUBLIC_CONTACT_EMAIL=

# --- Sanity (CMS for Insights, Casos, Autores, Prensa only — see
# README.md's "Sanity CMS" section) --------------------------------------
# NOT yet connected to the public frontend. Needed to run the Studio
# (/studio) and the migration script.

# From sanity.io/manage → your project.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# Server-only. A read-token (Viewer role is enough) — used only for
# Draft Mode/preview, never sent to the browser.
SANITY_API_READ_TOKEN=

# Server-only. A write-token (Editor role) — used only by
# `npm run migrate:sanity`, never at request time.
SANITY_API_WRITE_TOKEN=

# Shared secret for the Studio's "Open preview" action (src/app/api/draft).
# Any long random string; must match on both ends, it isn't a Sanity value.
SANITY_PREVIEW_SECRET=

# Shared secret configured on the Sanity webhook that calls
# src/app/api/revalidate — copy the value Sanity generates when you
# create the webhook (Manage → API → Webhooks).
SANITY_REVALIDATE_SECRET=

# Absolute site URL, used to build the preview redirect link from the
# Studio. http://localhost:3000 in development.
NEXT_PUBLIC_SITE_URL=
